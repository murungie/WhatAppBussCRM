generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id              String  @id @default(uuid())
  name            String
  ownerEmail      String  @unique
  passwordHash    String
  whatsappPhoneId String?
  whatsappToken   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers      Customer[]
  autoReplyRules AutoReplyRule[]
  broadcasts     Broadcast[]

  @@map("businesses")
}

model Customer {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  phoneNumber String
  name        String?

  lastOrderAt DateTime?
  lastInboundAt DateTime?
  totalSpent  Decimal   @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages            Message[]
  orders              Order[]
  autoReplyRules      AutoReplyRule[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([businessId, phoneNumber])
  @@index([businessId])
  @@index([phoneNumber])
  @@map("customers")
}

model Message {
  id         String   @id @default(uuid())
  businessId String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  direction   Direction
  content     String
  waMessageId String?

  status MessageStatus @default(SENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([customerId])
  @@index([waMessageId])
  @@index([status])
  @@map("messages")
}

model Order {
  id         String   @id @default(uuid())
  businessId String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal     @db.Decimal(12, 2)
  status      OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?

  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model Payment {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method    String   @default("mpesa")
  reference String?
  paidAt    DateTime @default(now())

  @@map("payments")
}

model AutoReplyRule {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  keyword  String
  response String
  isActive Boolean @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  Customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  @@index([businessId])
  @@index([isActive])
  @@map("auto_reply_rules")
}

model Broadcast {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type BroadcastType @default(TEXT)

  // Used when type = TEXT
  message String?

  // Used when type = TEMPLATE
  templateName     String?
  templateLanguage String?

  // Example:
  // ["{{customer.name}}", "{{broadcast.id}}", "{{date}}"]
  templateParameters Json?

  segment String @default("ALL")

  status BroadcastStatus @default(DRAFT)

  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)

  scheduledAt DateTime?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients BroadcastRecipient[]

  @@index([businessId])
  @@index([status])
  @@index([scheduledAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id String @id @default(uuid())

  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status BroadcastRecipientStatus @default(PENDING)

  waMessageId String?
  error       String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([broadcastId, customerId])
  @@index([broadcastId])
  @@index([customerId])
  @@index([status])
  @@map("broadcast_recipients")
}

enum BroadcastStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
  WINDOW_EXPIRED
}

enum BroadcastType {
  TEXT
  TEMPLATE
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}
